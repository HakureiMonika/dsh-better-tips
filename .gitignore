# Default deny: only reviewed source and release files may enter Git.
/*
!/.gitignore
!/package.json
!/index.js
!/client.js
!/cordis.patch.yml
!/icon.svg
!/README.md
!/README_EN.md
!/screenshots.json
!/CHANGELOG.md
!/RELEASE_NOTES.md
!/LICENSE

!/sample/
/sample/*
!/sample/sample1.png
!/sample/sample2.png
!/sample/sample3.png
!/sample/sample4.png
!/sample/sample5.png
!/sample/sample6.png
!/sample/sample7.png
!/sample/sample8.png

!/lib/
/lib/*
!/lib/policy.js
!/lib/log-metadata.js
!/lib/fetch-diagnostics.js

!/locale/
/locale/*
!/locale/zh.json
!/locale/en.json

!/test/
/test/*
!/test/client.test.mjs
!/test/host.test.mjs
!/test/fetch-diagnostics.test.mjs
!/test/log-metadata.test.mjs
!/test/policy.test.mjs

!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
